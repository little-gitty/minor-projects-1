<project name="MyProject" default="compile" basedir=".">
    <target name="compile">
        <javac srcdir="src" destdir="build/classes"/>
    </target>
    <target name="jar" depends="compile">
        <mkdir dir="build/jar"/>
        <jar destfile="build/jar/MyProject.jar" basedir="build/classes"/>
    </target>
</project>
